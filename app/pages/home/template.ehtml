import "./style.css";
import { redirect } from "@elements/app";
import type { Listener } from "@elements/app";
import { Layout } from "#app/shared/templates/layout";
import { LobbyState, LobbyChallenge, LobbyGame, createChallenge, cancelChallenge, acceptChallenge } from "#app/shared/services/lobby";
import { TIME_CONTROLS, timeControlLabel } from "#app/shared/chess";
import { Alert, AlertDescription, AlertAction } from "@elements/ui/alert";
import { Badge } from "@elements/ui/badge";
import { Button } from "@elements/ui/button";
import { Card, CardAction, CardContent } from "@elements/ui/card";
import { Empty } from "@elements/ui/empty";
import { Table, TableHead, TableCell } from "@elements/ui/table";

interface Me {
  id: string;
  handle: string;
}

interface Lobby {
  state: LobbyState;
  error: string;
}

const PACE: Record<string, string> = { "3+2": "Blitz", "5+0": "Blitz", "10+0": "Rapid" };

function onNotify(lobby: Lobby, me: Me, next: LobbyState) {
  lobby.state = next;

  if (next.started && next.started.userIds.includes(me.id)) {
    redirect(`/games/${next.started.gameId}`);
  }
}

function onCreate(lobby: Lobby, initialMs: number, incrementMs: number) {
  try {
    lobby.error = "";
    createChallenge(initialMs, incrementMs);
  } catch (err: any) {
    lobby.error = err.message;
  }
}

function onAccept(lobby: Lobby, challengeId: string) {
  try {
    lobby.error = "";
    redirect(`/games/${acceptChallenge(challengeId)}`);
  } catch (err: any) {
    lobby.error = err.message;
  }
}

function myChallenge(state: LobbyState, me: Me): LobbyChallenge | undefined {
  return state.challenges.find((c) => c.creatorId === me.id);
}

function myGame(state: LobbyState, me: Me): LobbyGame | undefined {
  return state.games.find((g) => g.whiteHandle === me.handle || g.blackHandle === me.handle);
}

<html lang="en" class="page-home" (
  listener: Listener<LobbyState>,
  initial: LobbyState,
  me: Me,
  private lobby: Lobby = { state: initial, error: "" },
) oninit={() => listener.on("notify", (next) => onNotify(lobby, me, next))}>
  <Layout title="Lobby">
    <div class="lobby">
      <div class="stack is-xl">
        <Alert e:if={myGame(lobby.state, me)} variant="accent" role="status">
          <AlertDescription>You have a game in progress.</AlertDescription>
          <AlertAction>
            <Button variant="primary" size="sm" href={`/games/${myGame(lobby.state, me)!.id}`}>Back to the board</Button>
          </AlertAction>
        </Alert>

        <section class="stack">
          <div class="stack is-xs">
            <h1>Play</h1>
            <p class="lede">Post a challenge and the first player to accept gets the other color.</p>
          </div>

          <Alert e:if={lobby.error} variant="danger" description={lobby.error} />

          <div class="tc-picker">
            <Button e:for={tc of TIME_CONTROLS.map((t) => ({ ...t, id: timeControlLabel(t.initialMs, t.incrementMs) }))}
                    class="tc-button"
                    variant={myChallenge(lobby.state, me)?.initialMs === tc.initialMs && myChallenge(lobby.state, me)?.incrementMs === tc.incrementMs ? "primary" : "outline"}
                    onclick={() => onCreate(lobby, tc.initialMs, tc.incrementMs)}>
              <strong>{tc.id}</strong>
              <small>{PACE[tc.id]}</small>
            </Button>
          </div>

          <Alert e:if={myChallenge(lobby.state, me)} role="status">
            <AlertDescription>
              <Badge variant="accent" dot class="waiting">Waiting</Badge>
              Your {timeControlLabel(myChallenge(lobby.state, me)!.initialMs, myChallenge(lobby.state, me)!.incrementMs)} challenge is open. The game starts when someone accepts.
            </AlertDescription>
            <AlertAction>
              <Button variant="ghost" size="sm" onclick={() => cancelChallenge()}>Cancel</Button>
            </AlertAction>
          </Alert>
        </section>

        <section class="stack is-sm">
          <h2 class="text-xl">Open challenges</h2>
          <Table e:if={lobby.state.challenges.length > 0} label="Open challenges">
            <table>
              <thead>
                <tr>
                  <TableHead>Player</TableHead>
                  <TableHead align="end">Rating</TableHead>
                  <TableHead>Time</TableHead>
                  <TableHead align="end" class="act"></TableHead>
                </tr>
              </thead>
              <tbody>
                <tr e:for={c of lobby.state.challenges}>
                  <TableCell><a href={`/players/${c.handle}`}>{c.handle}</a></TableCell>
                  <TableCell align="end">{c.rating}</TableCell>
                  <TableCell>{timeControlLabel(c.initialMs, c.incrementMs)}</TableCell>
                  <TableCell align="end" class="act">
                    <Badge e:if={c.creatorId === me.id} variant="secondary">Yours</Badge>
                    <Button e:else variant="primary" size="sm" onclick={() => onAccept(lobby, c.id)}>Accept</Button>
                  </TableCell>
                </tr>
              </tbody>
            </table>
          </Table>
          <Empty e:else variant="muted" description="No open challenges. Post one above." />
        </section>

        <section class="stack is-sm">
          <h2 class="text-xl">Games in progress</h2>
          <Table e:if={lobby.state.games.length > 0} label="Games in progress">
            <table>
              <thead>
                <tr>
                  <TableHead>White</TableHead>
                  <TableHead>Black</TableHead>
                  <TableHead>Time</TableHead>
                  <TableHead align="end" class="act"></TableHead>
                </tr>
              </thead>
              <tbody>
                <tr e:for={g of lobby.state.games}>
                  <TableCell>{g.whiteHandle} <span class="online-rating text-sm">{g.whiteRating}</span></TableCell>
                  <TableCell>{g.blackHandle} <span class="online-rating text-sm">{g.blackRating}</span></TableCell>
                  <TableCell>{timeControlLabel(g.initialMs, g.incrementMs)}</TableCell>
                  <TableCell align="end" class="act"><Button size="sm" href={`/games/${g.id}`}>Watch</Button></TableCell>
                </tr>
              </tbody>
            </table>
          </Table>
          <Empty e:else variant="muted" description="Nobody is playing right now." />
        </section>
      </div>

      <aside class="lobby-side">
        <Card title="Online" level={2}>
          <CardAction slot="action"><Badge variant="secondary">{lobby.state.online.length}</Badge></CardAction>
          <CardContent>
            <ul class="online-list stack is-sm">
              <li e:for={p of lobby.state.online} class="row">
                <span><span class="online-dot"></span><a href={`/players/${p.handle}`}>{p.handle}</a></span>
                <span class="row is-baseline gap-2">
                  <Badge e:if={p.playing} variant="secondary">playing</Badge>
                  <span class="online-rating text-sm">{p.rating}</span>
                </span>
              </li>
            </ul>
          </CardContent>
        </Card>
      </aside>
    </div>
  </Layout>
</html>

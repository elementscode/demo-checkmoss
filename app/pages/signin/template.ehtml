import "./style.css";
import { redirect } from "@elements/app";
import { Layout } from "#app/shared/templates/layout";
import { signin } from "#app/shared/services/auth";
import { Alert } from "@elements/ui/alert";
import { Button } from "@elements/ui/button";
import { Card, CardContent } from "@elements/ui/card";
import { Field } from "@elements/ui/field";
import { Input } from "@elements/ui/input";
import { Item, ItemGroup, ItemContent, ItemTitle, ItemActions } from "@elements/ui/item";

export interface DemoPlayer {
  id: string;
  handle: string;
  rating: number;
}

interface SigninForm {
  login: string;
  password: string;
  error: string;
}

export const DEMO_PASSWORD = "checkmoss";

function onSubmit(form: SigninForm) {
  try {
    signin(form.login, form.password);
    form.error = "";
    redirect("/");
  } catch (err: any) {
    form.error = err.message;
  }
}

function onUseDemo(form: SigninForm, handle: string) {
  form.login = handle;
  form.password = DEMO_PASSWORD;
  onSubmit(form);
}

<html lang="en" class="page-signin" (
  demo: DemoPlayer[],
  private form: SigninForm = { login: "", password: "", error: "" },
)>
  <Layout title="Sign in" width="is-form">
    <div class="signin-grid">
      <div class="signin-intro stack is-xs">
        <h1>Sign in to play</h1>
        <p class="lede">Live games at 3+2, 5+0 and 10+0, rated after every result.</p>
      </div>

      <Card>
        <CardContent>
          <form class="stack" onsubmit={() => onSubmit(form)}>
            <Alert e:if={form.error} variant="danger" description={form.error} />

            <Field label="Username or email" required>
              <Input value={form.login}
                     name="username"
                     attrs={{ id: "login", autocomplete: "username", autocapitalize: "none", spellcheck: "false" }} />
            </Field>

            <Field label="Password" required>
              <Input value={form.password}
                     type="password"
                     name="password"
                     attrs={{ id: "password", autocomplete: "current-password" }} />
            </Field>

            <Button type="submit" variant="primary" block>Sign in</Button>

            <p class="text-sm">New here? <a href="/signup">Create an account</a></p>
          </form>
        </CardContent>
      </Card>

      <Card title="Demo players" level={2}>
        <CardContent>
          <div class="stack is-sm">
            <p class="text-sm">Every demo account's password is <code>{DEMO_PASSWORD}</code>. Ada and Chen are mid-game.</p>
            <ItemGroup label="Demo players">
              <Item e:for={p of demo} size="xs">
                <ItemContent>
                  <ItemTitle>{p.handle} <span class="demo-rating text-sm">{p.rating}</span></ItemTitle>
                </ItemContent>
                <ItemActions>
                  <Button size="sm" onclick={() => onUseDemo(form, p.handle)}>Sign in as {p.handle}</Button>
                </ItemActions>
              </Item>
            </ItemGroup>
          </div>
        </CardContent>
      </Card>
    </div>
  </Layout>
</html>

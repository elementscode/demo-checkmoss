import "./style.css";
import type { Listener } from "@elements/app";
import { Layout } from "#app/shared/templates/layout";
import { timeControlLabel } from "#app/shared/chess";
import { Button } from "@elements/ui/button";
import { Empty } from "@elements/ui/empty";
import { Table, TableHead, TableCell } from "@elements/ui/table";

export interface Profile {
  id: string;
  handle: string;
  rating: number;
  createdAt: Date;
}

export interface HistoryRow {
  id: string;
  status: "active" | "finished";
  result: "1-0" | "0-1" | "1/2-1/2" | null;
  reason: string | null;
  initialMs: number;
  incrementMs: number;
  plies: number;
  createdAt: Date;
  asWhite: boolean;
  opponent: string;
  opponentRating: number;
  delta: number | null;
}

type Outcome = "win" | "loss" | "draw" | "live";

function outcome(g: HistoryRow): Outcome {
  if (g.status === "active") {
    return "live";
  }

  if (g.result === "1/2-1/2") {
    return "draw";
  }

  return (g.result === "1-0") === g.asWhite ? "win" : "loss";
}

const OUTCOME_LABEL: Record<Outcome, string> = { win: "Won", loss: "Lost", draw: "Draw", live: "Playing" };

function count(games: HistoryRow[], o: Outcome): number {
  return games.filter((g) => outcome(g) === o).length;
}

function deltaText(d: number | null): string {
  return d === null ? "" : d >= 0 ? `+${d}` : `${d}`;
}

function shortDate(d: Date): string {
  return new Date(d).toLocaleDateString("en", { month: "short", day: "numeric" });
}

<html lang="en" class="page-player" (
  profile: Profile,
  games: HistoryRow[],
  presence: Listener<unknown>,
)>
  <Layout title={profile.handle} width="is-form">
    <div class="stack is-xl">
      <div class="profile-head row">
        <div class="stack is-xs">
          <p class="eyebrow">Player</p>
          <h1>{profile.handle}</h1>
          <p class="muted text-sm">Joined {new Date(profile.createdAt).toLocaleDateString("en", { month: "long", year: "numeric" })}</p>
        </div>
        <div class="stack is-xs" style="text-align: right">
          <span class="muted text-sm">Rating</span>
          <span class="profile-rating">{profile.rating}</span>
        </div>
      </div>

      <div class="stats">
        <div class="stat"><strong>{games.filter((g) => g.status === "finished").length}</strong><span class="muted text-sm">Games</span></div>
        <div class="stat"><strong>{count(games, "win")}</strong><span class="muted text-sm">Wins</span></div>
        <div class="stat"><strong>{count(games, "draw")}</strong><span class="muted text-sm">Draws</span></div>
        <div class="stat"><strong>{count(games, "loss")}</strong><span class="muted text-sm">Losses</span></div>
      </div>

      <section class="stack is-sm">
        <h2 class="text-xl">Games</h2>
        <Table e:if={games.length > 0} label="Games" class="history">
          <table>
            <thead>
              <tr>
                <TableHead class="wraps">Color · opponent</TableHead>
                <TableHead class="wraps">Result</TableHead>
                <TableHead class="hide-sm">Time</TableHead>
                <TableHead align="end">Rating</TableHead>
                <TableHead class="hide-sm">Date</TableHead>
                <TableHead align="end"></TableHead>
              </tr>
            </thead>
            <tbody>
              <tr e:for={g of games}>
                <TableCell class="wraps">
                  <span class={["color-chip", g.asWhite ? "is-white" : "is-black"]} title={`${profile.handle} played ${g.asWhite ? "white" : "black"}`}></span>
                  <a href={`/players/${g.opponent}`}>{g.opponent}</a>
                  <span class="muted text-sm"> {g.opponentRating}</span>
                </TableCell>
                <TableCell class="wraps">
                  <span class={["outcome", `is-${outcome(g)}`]}>{OUTCOME_LABEL[outcome(g)]}</span>
                  <span e:if={g.reason} class="muted text-sm"> · {g.reason}</span>
                </TableCell>
                <TableCell class="hide-sm">{timeControlLabel(g.initialMs, g.incrementMs)}</TableCell>
                <TableCell align="end" class={["delta", (g.delta ?? 0) >= 0 ? "is-up" : "is-down"].join(" ")}>{deltaText(g.delta)}</TableCell>
                <TableCell class="hide-sm muted text-sm">{shortDate(g.createdAt)}</TableCell>
                <TableCell align="end" class="act">
                  <Button e:if={g.status === "active"} size="sm" variant="primary" href={`/games/${g.id}`}>Watch</Button>
                  <Button e:else size="sm" href={`/games/${g.id}?ply=0`}>Replay</Button>
                </TableCell>
              </tr>
            </tbody>
          </table>
        </Table>
        <Empty e:else variant="outline" description="No games yet." />
      </section>
    </div>
  </Layout>
</html>

import "./style.css";
import { redirect } from "@elements/app";
import { Layout } from "#app/shared/templates/layout";
import { signup, SignupForm, MIN_PASSWORD } from "#app/shared/services/auth";
import { Alert } from "@elements/ui/alert";
import { Button } from "@elements/ui/button";
import { Field } from "@elements/ui/field";
import { Input } from "@elements/ui/input";

function onSubmit(form: SignupForm) {
  try {
    signup(form);
    form.error = "";
    redirect("/");
  } catch (err: any) {
    form.error = err.message;
  }
}

<html lang="en" class="page-signup" (
  private form: SignupForm = { handle: "", email: "", password: "", error: "" },
)>
  <Layout title="Create an account" width="is-narrow">
    <form class="stack" onsubmit={() => onSubmit(form)}>
      <h1>Create an account</h1>

      <Alert e:if={form.error} variant="danger" description={form.error} />

      <Field label="Username" description="What opponents see. 3 to 20 letters, digits, - or _." required>
        <Input value={form.handle}
               name="username"
               attrs={{ id: "handle", autocomplete: "username", autocapitalize: "none", spellcheck: "false", minlength: 3, maxlength: 20, pattern: "[A-Za-z0-9_\\-]+" }} />
      </Field>

      <Field label="Email" required>
        <Input value={form.email}
               type="email"
               name="email"
               attrs={{ id: "email", autocomplete: "email", autocapitalize: "none", spellcheck: "false" }} />
      </Field>

      <Field label="Password" description={`At least ${MIN_PASSWORD} characters.`} required>
        <Input value={form.password}
               type="password"
               name="password"
               attrs={{ id: "password", autocomplete: "new-password", minlength: MIN_PASSWORD }} />
      </Field>

      <Button type="submit" variant="primary" block>Create account</Button>

      <p class="text-sm">Have an account? <a href="/signin">Sign in</a></p>
    </form>
  </Layout>
</html>

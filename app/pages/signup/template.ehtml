import "./style.css";
import { redirect } from "@elements/app";
import { Layout } from "#app/shared/templates/layout";
import { signup, SignupForm, MIN_PASSWORD } from "#app/shared/services/auth";

function onSubmit(form: SignupForm) {
  try {
    signup(form);
    form.error = "";
    redirect("/");
  } catch (err: any) {
    form.error = err.message;
  }
}

<html lang="en" class="page-signup" (
  private form: SignupForm = { handle: "", email: "", password: "", error: "" },
)>
  <Layout title="Create an account" width="is-narrow">
    <form class="stack" onsubmit={() => onSubmit(form)}>
      <h1>Create an account</h1>

      <p e:if={form.error} class="callout is-danger" role="alert">{form.error}</p>

      <div class="field">
        <label for="handle">Username</label>
        <input id="handle"
               name="username"
               value={form.handle}
               autocomplete="username"
               autocapitalize="none"
               spellcheck={false}
               minlength={3}
               maxlength={20}
               pattern="[A-Za-z0-9_\-]+"
               required>
        <p class="hint">What opponents see. 3 to 20 letters, digits, - or _.</p>
      </div>

      <div class="field">
        <label for="email">Email</label>
        <input id="email"
               name="email"
               type="email"
               value={form.email}
               autocomplete="email"
               autocapitalize="none"
               spellcheck={false}
               required>
      </div>

      <div class="field">
        <label for="password">Password</label>
        <input id="password"
               name="password"
               type="password"
               value={form.password}
               autocomplete="new-password"
               minlength={MIN_PASSWORD}
               required>
        <p class="hint">At least {MIN_PASSWORD} characters.</p>
      </div>

      <button type="submit" class="is-primary is-block">Create account</button>

      <p class="text-sm">Have an account? <a href="/signin">Sign in</a></p>
    </form>
  </Layout>
</html>
